{
  "org": "Cloudbird-Software",
  "comment": "组织治理期望状态。drift-check.sh 据此检测漂移；apply.sh 据此幂等修复。ruleset 完整定义在 rulesets/ 目录。",
  "actions_policy": {
    "allowed_actions": "selected",
    "github_owned_allowed": true,
    "verified_allowed": true,
    "patterns_allowed": [
