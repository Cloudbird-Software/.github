  "code_security": {
    "configuration_name": "GitHub recommended",
    "default_for_new_repos": "all"
  },
  "repo_baseline": {
    "squash_only": true,
    "delete_branch_on_merge": true,
    "exclude_repos": [
      "AI_Web_School"
    ]
  },
  "org_secrets_required": [
    "CB_APP_ID",
    "AGENT_APP_SECRET",
    "GOVERNANCE_TOKEN"
